[Unit]
Description=LoL Worlds schedule/score adapter for Glance
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/systemd/system/glance-waqi.env
ExecStart=/usr/bin/python3 /opt/lol_worlds.py
Restart=always
RestartSec=15
User=glance
Group=glance
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
