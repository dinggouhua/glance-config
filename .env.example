# Glance 工作台环境变量模板
# 用法：复制为 /etc/systemd/system/glance-waqi.env，填入真实值后
#       chmod 640 /etc/systemd/system/glance-waqi.env
#       systemctl daemon-reload && systemctl restart glance
#
# 说明：glance.yml 与适配器只通过 ${VAR} / os.environ 读取这些值，
#       真实值绝不写入仓库。

# ---- Glance 主服务（glance.service）----
# WAQI 空气质量 Token（https://aqicn.org/data-platform/token/）
WAQI_TOKEN=
# Todoist API Token（工作重点 widget，REST v1）
TODOIST_API_TOKEN=
# 天气/日出日落地点
WEATHER_LOCATION=Taizhou, Jiangsu, China
# 江苏省城市足球联赛（聚合数据 football/rank 接口 key）
JUHE_FOOTBALL_KEY=
# Riot 官方电竞 API 的公开 key（lolesports.com 前端同一枚，用于 lol_worlds.py 抓世界赛赛程/比分）
LOLESPORTS_API_KEY=
# 代理类接口密钥（如 sing-box / clash 面板）
CLASH_API_SECRET=

# ---- 本地适配器 ----
# 聚合数据：今日油价（oil_price.py）
JUHE_OIL_APIKEY=
# 极速数据：大乐透（lottery.py）
JISUAPI_APPKEY=
# AI 中转站余额适配器（glance-relay-balance.service，/etc/glance/glance-relay.env）
RELAY_USER_URL=
RELAY_API_KEY=
RELAY_BALANCE_PORT=8906
